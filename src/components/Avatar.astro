---
interface Props {
  src?: string;
  alt?: string;
  name: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  [key: string]: unknown;
}

const { src, alt, name, size = 'md', ...rest } = Astro.props as Props;

const initials = name
  .trim()
  .split(/\s+/)
  .map((word) => word.charAt(0))
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<span class:list={['nx-avatar', `s-${size}`]} {...rest}>
  {
    src ? (
      <img class="nx-avatar-img" src={src} alt={alt ?? name} loading="lazy" />
    ) : (
      <span class="nx-avatar-fallback">{initials}</span>
    )
  }
</span>

<style>
  .nx-avatar {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--nx-radius-full);
    border: 2px solid var(--nx-border-glow);
    background: var(--nx-bg-elevated);
    line-height: 1;
  }

  .s-sm {
    width: 32px;
    height: 32px;
  }

  .s-md {
    width: 40px;
    height: 40px;
  }

  .s-lg {
    width: 56px;
    height: 56px;
  }

  .s-xl {
    width: 80px;
    height: 80px;
  }

  .nx-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .nx-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--nx-gradient-brand);
    color: var(--nx-text-inverse);
    font-family: var(--nx-font-body);
    font-weight: var(--nx-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    user-select: none;
  }

  .s-sm .nx-avatar-fallback {
    font-size: var(--nx-text-xs);
  }

  .s-md .nx-avatar-fallback {
    font-size: var(--nx-text-sm);
  }

  .s-lg .nx-avatar-fallback {
    font-size: var(--nx-text-base);
  }

  .s-xl .nx-avatar-fallback {
    font-size: var(--nx-text-lg);
  }
</style>

---
interface Props {
  open?: boolean;
  title: string;
  size?: 'sm' | 'md' | 'lg';
  closable?: boolean;
  [key: string]: unknown;
}

const {
  open = false,
  title,
  size = 'md',
  closable = true,
  ...rest
} = Astro.props as Props;
---

<div class="nx-modal" data-nx-modal hidden={open ? undefined : ''} {...rest}>
  <div class="nx-modal-backdrop" data-nx-modal-backdrop></div>
  <div class:list={['nx-modal-panel', `s-${size}`]} role="dialog" aria-modal="true" aria-label={title} tabindex="-1">
    <div class="nx-modal-header">
      <h3 class="nx-modal-title">{title}</h3>
      {
        closable && (
          <button type="button" class="nx-modal-close" data-nx-modal-close aria-label="Close">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        )
      }
    </div>
    <div class="nx-modal-body">
      <slot />
    </div>
  </div>
</div>

<script>
  const SEL = '[data-nx-modal]';
  const FOCUSABLE = 'a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
  const prev = new WeakMap<Element, Element | null>();
  const panelOf = (m: Element) => m.querySelector<HTMLElement>('[role="dialog"]');
  const focusables = (p: HTMLElement) => [...p.querySelectorAll<HTMLElement>(FOCUSABLE)];

  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest('[data-nx-modal-close]') || e.target.matches('[data-nx-modal-backdrop]')) e.target.closest(SEL)?.setAttribute('hidden', '');
  });

  document.addEventListener('keydown', (e) => {
    const m = [...document.querySelectorAll(SEL)].filter((x) => !x.hasAttribute('hidden')).pop();
    if (!m) return;
    if (e.key === 'Escape') { e.preventDefault(); m.setAttribute('hidden', ''); return; }
    if (e.key !== 'Tab') return;
    const p = panelOf(m);
    if (!p) return;
    const items = focusables(p);
    if (!items.length) { e.preventDefault(); p.focus(); return; }
    const [first, last] = [items[0], items[items.length - 1]];
    const active = document.activeElement;
    if (e.shiftKey ? active === first || !p.contains(active) : active === last || !p.contains(active)) {
      e.preventDefault();
      (e.shiftKey ? last : first).focus();
    }
  });

  const observer = new MutationObserver((mutations) => {
    for (const mut of mutations) {
      if (mut.type !== 'attributes' || mut.attributeName !== 'hidden') continue;
      const m = mut.target;
      const open = !m.hasAttribute('hidden');
      const p = prev.get(m);
      if (!open) prev.delete(m);
      else prev.set(m, document.activeElement);
      const panel = open ? panelOf(m) : null;
      if (open && panel) (focusables(panel)[0] ?? panel).focus();
      else if (!open && p instanceof HTMLElement && document.contains(p)) p.focus();
    }
  });

  document.querySelectorAll(SEL).forEach((m) => {
    if (!m.hasAttribute('hidden')) prev.set(m, document.activeElement);
    observer.observe(m, { attributes: true, attributeFilter: ['hidden'] });
  });
</script>

<style>
  .nx-modal {
    position: fixed;
    inset: 0;
    z-index: var(--nx-z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--nx-space-4);
  }

  .nx-modal[hidden] {
    display: none;
  }

  .nx-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .nx-modal-panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-height: min(85vh, 100%);
    overflow: auto;
    background: var(--nx-bg-card);
    border: 1px solid var(--nx-border);
    border-radius: var(--nx-radius-xl);
    box-shadow: var(--nx-shadow-card);
  }

  .s-sm {
    max-width: 400px;
  }

  .s-md {
    max-width: 560px;
  }

  .s-lg {
    max-width: 720px;
  }

  .nx-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--nx-space-4);
    padding: var(--nx-space-5) var(--nx-space-6);
    border-bottom: 1px solid var(--nx-border);
  }

  .nx-modal-title {
    margin: 0;
    font-family: var(--nx-font-display);
    font-size: var(--nx-text-lg);
    font-weight: var(--nx-weight-bold);
    color: var(--nx-text-primary);
    letter-spacing: -0.01em;
  }

  .nx-modal-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: var(--nx-radius-md);
    border: 1px solid transparent;
    background: transparent;
    color: var(--nx-text-secondary);
    cursor: pointer;
    transition:
      background var(--nx-duration-fast) var(--nx-ease),
      border-color var(--nx-duration-fast) var(--nx-ease),
      color var(--nx-duration-fast) var(--nx-ease);
  }

  .nx-modal-close:hover {
    background: color-mix(in srgb, var(--nx-danger) 12%, transparent);
    border-color: color-mix(in srgb, var(--nx-danger) 30%, transparent);
    color: var(--nx-danger);
  }

  .nx-modal-close:focus-visible {
    outline: 2px solid var(--nx-cyan);
    outline-offset: 2px;
  }

  .nx-modal-body {
    padding: var(--nx-space-6);
    color: var(--nx-text-secondary);
    font-size: var(--nx-text-base);
    line-height: var(--nx-leading-normal);
  }
</style>

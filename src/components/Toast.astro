---
interface Props {
  variant?: 'success' | 'warning' | 'danger' | 'info';
  title: string;
  message?: string;
  position?: 'top-right' | 'bottom-right' | 'top-left' | 'bottom-left';
  demo?: boolean;
  [key: string]: unknown;
}

const {
  variant = 'info',
  title,
  message,
  position = 'top-right',
  demo = false,
  ...rest
} = Astro.props as Props;

const icons: Record<string, string> = {
  success: '✓',
  warning: '!',
  danger: '×',
  info: 'i',
};
---

<div
  class:list={['nx-toast', `v-${variant}`, `pos-${position}`, { demo }]}
  role={variant === 'danger' ? 'alert' : 'status'}
  {...rest}
>
  <span class="nx-toast-icon" aria-hidden="true">{icons[variant]}</span>
  <div class="nx-toast-content">
    <p class="nx-toast-title">{title}</p>
    {message && <p class="nx-toast-message">{message}</p>}
  </div>
  <button type="button" class="nx-toast-close" data-nx-toast-close aria-label="Dismiss">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>
</div>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const closeButton = target.closest('[data-nx-toast-close]');
    if (closeButton) {
      const toast = closeButton.closest('.nx-toast');
      if (toast instanceof HTMLElement) {
        toast.hidden = true;
      }
    }
  });
</script>

<style>
  .nx-toast {
    --toast-color: var(--nx-info);

    position: fixed;
    z-index: var(--nx-z-toast);
    display: flex;
    align-items: flex-start;
    gap: var(--nx-space-3);
    min-width: 280px;
    max-width: 360px;
    padding: var(--nx-space-4);
    background: var(--nx-bg-elevated);
    border: 1px solid var(--nx-border);
    border-left: 4px solid var(--toast-color);
    border-radius: var(--nx-radius-lg);
    box-shadow: var(--nx-shadow-card);
  }

  .nx-toast[hidden] {
    display: none;
  }

  .nx-toast.demo {
    position: static;
    width: 100%;
    max-width: none;
    min-width: 0;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
  }

  .pos-top-right {
    top: var(--nx-space-4);
    right: var(--nx-space-4);
  }

  .pos-bottom-right {
    bottom: var(--nx-space-4);
    right: var(--nx-space-4);
  }

  .pos-top-left {
    top: var(--nx-space-4);
    left: var(--nx-space-4);
  }

  .pos-bottom-left {
    bottom: var(--nx-space-4);
    left: var(--nx-space-4);
  }

  .v-success {
    --toast-color: var(--nx-success);
  }

  .v-warning {
    --toast-color: var(--nx-warning);
  }

  .v-danger {
    --toast-color: var(--nx-danger);
  }

  .v-info {
    --toast-color: var(--nx-info);
  }

  .nx-toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: var(--nx-radius-full);
    background: color-mix(in srgb, var(--toast-color) 15%, transparent);
    color: var(--toast-color);
    font-family: var(--nx-font-body);
    font-size: var(--nx-text-sm);
    font-weight: var(--nx-weight-bold);
    line-height: 1;
  }

  .nx-toast-content {
    flex: 1;
    min-width: 0;
  }

  .nx-toast-title {
    margin: 0;
    font-family: var(--nx-font-body);
    font-size: var(--nx-text-sm);
    font-weight: var(--nx-weight-bold);
    color: var(--nx-text-primary);
    line-height: 1.3;
  }

  .nx-toast-message {
    margin: var(--nx-space-1) 0 0;
    font-size: var(--nx-text-sm);
    color: var(--nx-text-secondary);
    line-height: var(--nx-leading-normal);
  }

  .nx-toast-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    border-radius: var(--nx-radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--nx-text-muted);
    cursor: pointer;
    transition:
      background var(--nx-duration-fast) var(--nx-ease),
      color var(--nx-duration-fast) var(--nx-ease);
  }

  .nx-toast-close:hover {
    background: color-mix(in srgb, var(--nx-danger) 12%, transparent);
    color: var(--nx-danger);
  }

  .nx-toast-close:focus-visible {
    outline: 2px solid var(--nx-cyan);
    outline-offset: 2px;
  }
</style>

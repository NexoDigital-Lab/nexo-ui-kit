---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Avatar from '../../components/Avatar.astro';

const sizes = ['sm', 'md', 'lg', 'xl'] as const;

const snippet = `<Avatar name="Ada Lovelace" />

<Avatar name="Grace Hopper" size="lg" />

<Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Nexo teammate" name="Fallback Name" />

<Avatar name="Maximiliano Fernández" size="xl" />`;
---

<BaseLayout title="Avatar — Nexo UI Kit" description="Avatar component sizes, image source and initials fallback for the Nexo UI Kit.">
  <SectionHeader
    badge="Components"
    title="Avatar"
    subtitle="Circular user image with a neon ring, or a gradient initials fallback when no src is given."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Sizes</h2>
    <div class="docs-example docs-example-center">
      {sizes.map((size) => <Avatar name="Nexo Digital" size={size} />)}
    </div>
    <p class="docs-note">
      sm 32px · md 40px (default) · lg 56px · xl 80px
    </p>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">With image</h2>
    <div class="docs-example docs-example-center">
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Nexo teammate" name="Nexo Digital" size="sm" />
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Nexo teammate" name="Nexo Digital" size="md" />
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Nexo teammate" name="Nexo Digital" size="lg" />
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Nexo teammate" name="Nexo Digital" size="xl" />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Initials fallback</h2>
    <div class="docs-example docs-example-center">
      <Avatar name="Ada" />
      <Avatar name="Ada Lovelace" />
      <Avatar name="Grace Brewster Hopper" />
      <Avatar name="Maximiliano Fernández de la Cruz" size="lg" />
    </div>
    <p class="docs-note">
      Initials take the first letter of each word, max 2 characters, uppercased.
    </p>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Usage</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Type</th>
            <th>Default</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>src</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Image URL. When omitted, the initials fallback is rendered.</td>
          </tr>
          <tr>
            <td><code>alt</code></td>
            <td><code>string</code></td>
            <td><code>name</code></td>
            <td>Alt text for the image (ignored when using the fallback).</td>
          </tr>
          <tr>
            <td><code>name</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Used to derive initials when no image source is provided.</td>
          </tr>
          <tr>
            <td><code>size</code></td>
            <td><code>'sm' | 'md' | 'lg' | 'xl'</code></td>
            <td><code>'md'</code></td>
            <td>Diameter: 32px, 40px, 56px or 80px.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

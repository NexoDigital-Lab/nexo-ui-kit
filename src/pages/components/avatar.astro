---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Avatar from '../../components/Avatar.astro';

const sizes = ['sm', 'md', 'lg', 'xl'] as const;

const snippet = `<Avatar name="Ada Lovelace" />

<Avatar name="Grace Hopper" size="lg" />

<Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Nexo teammate" name="Fallback Name" />

<Avatar name="Maximiliano Fernández" size="xl" />`;
---

<BaseLayout title="Avatar — Nexo UI Kit" description="Tamaños, origen de imagen y reserva de iniciales del componente Avatar de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="Avatar"
    subtitle="Imagen de usuario circular con anillo neón, o reserva de iniciales en degradado cuando no se indica src."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Tamaños</h2>
    <div class="docs-example docs-example-center">
      {sizes.map((size) => <Avatar name="Nexo Digital" size={size} />)}
    </div>
    <p class="docs-note">
      sm 32px · md 40px (default) · lg 56px · xl 80px
    </p>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Con imagen</h2>
    <div class="docs-example docs-example-center">
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Miembro del equipo Nexo" name="Nexo Digital" size="sm" />
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Miembro del equipo Nexo" name="Nexo Digital" size="md" />
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Miembro del equipo Nexo" name="Nexo Digital" size="lg" />
      <Avatar src="https://i.pravatar.cc/150?u=nexo" alt="Miembro del equipo Nexo" name="Nexo Digital" size="xl" />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Reserva de iniciales</h2>
    <div class="docs-example docs-example-center">
      <Avatar name="Ada" />
      <Avatar name="Ada Lovelace" />
      <Avatar name="Grace Brewster Hopper" />
      <Avatar name="Maximiliano Fernández de la Cruz" size="lg" />
    </div>
    <p class="docs-note">
      Las iniciales toman la primera letra de cada palabra, máximo 2 caracteres, en mayúsculas.
    </p>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>src</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>URL de la imagen. Si se omite, se renderiza la reserva de iniciales.</td>
          </tr>
          <tr>
            <td><code>alt</code></td>
            <td><code>string</code></td>
            <td><code>name</code></td>
            <td>Texto alternativo de la imagen (ignorado al usar la reserva).</td>
          </tr>
          <tr>
            <td><code>name</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Se usa para derivar las iniciales cuando no se proporciona imagen.</td>
          </tr>
          <tr>
            <td><code>size</code></td>
            <td><code>'sm' | 'md' | 'lg' | 'xl'</code></td>
            <td><code>'md'</code></td>
            <td>Diámetro: 32px, 40px, 56px u 80px.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

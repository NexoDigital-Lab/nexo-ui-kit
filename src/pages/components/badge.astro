---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Badge from '../../components/Badge.astro';

const variants = ['cyan', 'purple', 'magenta', 'success', 'warning', 'danger', 'muted'] as const;

const snippet = `<Badge variant="cyan">Nuevo</Badge>

<Badge variant="success" dot>Approved</Badge>

<Badge variant="warning" size="sm">Pending</Badge>

<Badge variant="magenta" dot>Magenta</Badge>`;
---

<BaseLayout title="Badge — Nexo UI Kit" description="Variantes, tamaños e indicador de punto del componente Badge de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="Badge"
    subtitle="Etiquetas tipo píldora suaves para estado, categorías y metadatos, con un punto inicial opcional."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Variantes</h2>
    <div class="docs-example">
      {variants.map((variant) => <Badge variant={variant}>{variant}</Badge>)}
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Tamaños</h2>
    <div class="docs-example">
      <Badge variant="cyan" size="sm">Pequeño</Badge>
      <Badge variant="cyan" size="md">Mediano</Badge>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Con punto</h2>
    <div class="docs-example">
      <Badge variant="success" dot>Aprobado</Badge>
      <Badge variant="warning" dot>Pendiente</Badge>
      <Badge variant="danger" dot>Rechazado</Badge>
      <Badge variant="cyan" size="sm" dot>En vivo</Badge>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Todas las variantes con punto</h2>
    <div class="docs-example">
      {variants.map((variant) => <Badge variant={variant} dot>{variant}</Badge>)}
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>variant</code></td>
            <td>
              <code>'cyan' | 'purple' | 'magenta' | 'success' | 'warning' | 'danger' | 'muted'</code>
            </td>
            <td><code>'cyan'</code></td>
            <td>Esquema de color del badge.</td>
          </tr>
          <tr>
            <td><code>size</code></td>
            <td><code>'sm' | 'md'</code></td>
            <td><code>'md'</code></td>
            <td>Relleno y tamaño de fuente.</td>
          </tr>
          <tr>
            <td><code>dot</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Renderiza un punto de estado inicial que hereda el color del badge.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Badge from '../../components/Badge.astro';

const variants = ['cyan', 'purple', 'magenta', 'success', 'warning', 'danger', 'muted'] as const;

const snippet = `<Badge variant="cyan">Nuevo</Badge>

<Badge variant="success" dot>Approved</Badge>

<Badge variant="warning" size="sm">Pending</Badge>

<Badge variant="magenta" dot>Magenta</Badge>`;
---

<BaseLayout title="Badge — Nexo UI Kit" description="Badge component variants, sizes and dot indicator for the Nexo UI Kit.">
  <SectionHeader
    badge="Components"
    title="Badge"
    subtitle="Soft pill labels for status, categories and metadata, with an optional leading dot."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Variants</h2>
    <div class="docs-example">
      {variants.map((variant) => <Badge variant={variant}>{variant}</Badge>)}
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Sizes</h2>
    <div class="docs-example">
      <Badge variant="cyan" size="sm">Small</Badge>
      <Badge variant="cyan" size="md">Medium</Badge>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">With dot</h2>
    <div class="docs-example">
      <Badge variant="success" dot>Approved</Badge>
      <Badge variant="warning" dot>Pending</Badge>
      <Badge variant="danger" dot>Rejected</Badge>
      <Badge variant="cyan" size="sm" dot>Live</Badge>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">All variants with dot</h2>
    <div class="docs-example">
      {variants.map((variant) => <Badge variant={variant} dot>{variant}</Badge>)}
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Usage</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Type</th>
            <th>Default</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>variant</code></td>
            <td>
              <code>'cyan' | 'purple' | 'magenta' | 'success' | 'warning' | 'danger' | 'muted'</code>
            </td>
            <td><code>'cyan'</code></td>
            <td>Color scheme of the badge.</td>
          </tr>
          <tr>
            <td><code>size</code></td>
            <td><code>'sm' | 'md'</code></td>
            <td><code>'md'</code></td>
            <td>Padding and font size.</td>
          </tr>
          <tr>
            <td><code>dot</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Renders a leading status dot that inherits the badge color.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

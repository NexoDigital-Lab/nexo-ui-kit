---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Button from '../../components/Button.astro';

const variants = ['primary', 'secondary', 'ghost', 'danger'] as const;
const sizes = ['sm', 'md', 'lg'] as const;

const snippet = `<Button variant="primary" size="md">Click me</Button>

<Button href="/tokens" variant="secondary" size="md">View tokens</Button>

<Button variant="ghost">Ghost action</Button>

<Button variant="danger" size="lg">Delete</Button>

<Button variant="primary" size="sm" disabled>Disabled</Button>`;
---

<BaseLayout title="Button — Nexo UI Kit" description="Variantes, tamaños y uso del componente Button de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="Button"
    subtitle="Disparador de acciones con variantes gradiente, outline, ghost y danger en tres tamaños."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Variantes</h2>
    <div class="docs-example">
      <Button variant="primary">Primario</Button>
      <Button variant="secondary">Secundario</Button>
      <Button variant="ghost">Ghost</Button>
      <Button variant="danger">Peligro</Button>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Tamaños</h2>
    <div class="docs-example">
      <Button size="sm">Pequeño</Button>
      <Button size="md">Mediano</Button>
      <Button size="lg">Grande</Button>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Todas las combinaciones</h2>
    <div class="docs-example docs-example-stack">
      {
        variants.map((variant) => (
          <p class="docs-example-label">{variant}</p>
          <div class="combo-row">
            {sizes.map((size) => (
              <Button variant={variant} size={size}>
                {size}
              </Button>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Enlace y deshabilitado</h2>
    <div class="docs-example">
      <Button href="/tokens" variant="secondary">Botón con enlace</Button>
      <Button variant="primary" disabled>Deshabilitado</Button>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>variant</code></td>
            <td><code>'primary' | 'secondary' | 'ghost' | 'danger'</code></td>
            <td><code>'primary'</code></td>
            <td>Estilo visual del botón.</td>
          </tr>
          <tr>
            <td><code>size</code></td>
            <td><code>'sm' | 'md' | 'lg'</code></td>
            <td><code>'md'</code></td>
            <td>Relleno y tamaño de fuente.</td>
          </tr>
          <tr>
            <td><code>href</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Renderiza el botón como enlace <code>&lt;a&gt;</code> cuando se proporciona.</td>
          </tr>
          <tr>
            <td><code>type</code></td>
            <td><code>'button' | 'submit' | 'reset'</code></td>
            <td><code>'button'</code></td>
            <td>Tipo nativo de botón (ignorado cuando se establece <code>href</code>).</td>
          </tr>
          <tr>
            <td><code>disabled</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Deshabilita la interacción y aplica opacidad reducida.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .combo-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nx-space-3);
    align-items: center;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import EmptyState from '../../components/EmptyState.astro';
import Button from '../../components/Button.astro';

const snippet = `<EmptyState
  icon="🚀"
  title="No projects yet"
  message="Create your first project to start collaborating with your team."
>
  <Button slot="action" variant="primary">Create project</Button>
</EmptyState>

<EmptyState
  title="Nothing to show here"
  message="Try adjusting your filters or check back later."
/>`;
---

<BaseLayout title="EmptyState — Nexo UI Kit" description="Ejemplos de icono, título, mensaje y slot de acción del componente EmptyState de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="EmptyState"
    subtitle="Marcador centrado para listas vacías y vistas sin datos, con un círculo de icono y una acción opcional."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Con icono y acción</h2>
    <div class="docs-example docs-example-stack">
      <EmptyState
        icon="🚀"
        title="Aún no hay proyectos"
        message="Crea tu primer proyecto para empezar a colaborar con tu equipo."
      >
        <Button slot="action" variant="primary">Crear proyecto</Button>
        <Button slot="action" variant="secondary" size="sm">Importar desde Git</Button>
      </EmptyState>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Sin acción</h2>
    <div class="docs-example docs-example-stack">
      <EmptyState
        icon="🔍"
        title="Sin resultados"
        message="Intenta ajustar los filtros o vuelve más tarde."
      />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Sin icono</h2>
    <div class="docs-example docs-example-stack">
      <EmptyState
        title="Aún no hay nada aquí"
        message="El contenido aparecerá en cuanto esté disponible."
      >
        <Button slot="action" variant="ghost" size="sm">Actualizar</Button>
      </EmptyState>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Slot de icono personalizado</h2>
    <div class="docs-example docs-example-stack">
      <EmptyState
        title="Bandeja al día"
        message="Estás al día. Las nuevas notificaciones aparecerán aquí."
      >
        <span slot="icon" class="empty-state-custom-icon" aria-hidden="true">✦</span>
        <Button slot="action" variant="secondary" size="sm">Ver archivo</Button>
      </EmptyState>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>title</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Encabezado con tipografía display para el estado vacío.</td>
          </tr>
          <tr>
            <td><code>message</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Texto de apoyo, limitado a 420px de ancho.</td>
          </tr>
          <tr>
            <td><code>icon</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Emoji o texto corto que se muestra dentro del círculo de icono de 72px.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="docs-note">
      Slots con nombre: <code class="docs-inline-code">icon</code> reemplaza el contenido del círculo de icono,
      <code class="docs-inline-code">action</code> renderiza el área de acción centrada opcional.
    </p>
  </section>
</BaseLayout>

<style>
  .empty-state-custom-icon {
    font-size: 1.75rem;
    color: var(--nx-cyan);
  }
</style>

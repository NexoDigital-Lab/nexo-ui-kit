---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Input from '../../components/Input.astro';

const snippet = `<Input label="Email" type="email" name="email" placeholder="you@example.com" />

<Input label="Password" type="password" name="password" required />

<Input name="search" type="search" placeholder="Search without label" />

<Input label="Username" name="username" error="This username is already taken." />`;
---

<BaseLayout title="Input — Nexo UI Kit" description="Tipos, etiquetas y estado de error del componente Input de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="Input"
    subtitle="Campos de formulario oscuros con etiquetas opcionales, anillo de foco y mensaje de error en línea."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Con etiqueta</h2>
    <div class="docs-example docs-example-stack" style="max-width: 420px;">
      <Input label="Nombre completo" name="name" placeholder="Ada Lovelace" />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Tipos</h2>
    <div class="docs-example docs-example-stack" style="max-width: 420px;">
      <Input label="Texto" type="text" name="text" placeholder="Texto plano" />
      <Input label="Correo electrónico" type="email" name="email" placeholder="you@example.com" />
      <Input label="Contraseña" type="password" name="password" placeholder="••••••••" />
      <Input label="Búsqueda" type="search" name="search" placeholder="Buscar…" />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Sin etiqueta</h2>
    <div class="docs-example docs-example-stack" style="max-width: 420px;">
      <Input name="bare" placeholder="Sin etiqueta" />
      <Input name="required-field" placeholder="Campo obligatorio" required />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Estado de error</h2>
    <div class="docs-example docs-example-stack" style="max-width: 420px;">
      <Input
        label="Nombre de usuario"
        name="username"
        placeholder="Elige un nombre de usuario"
        error="Este nombre de usuario ya está en uso."
      />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>label</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Etiqueta opcional renderizada sobre el campo.</td>
          </tr>
          <tr>
            <td><code>placeholder</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Texto de marcador de posición.</td>
          </tr>
          <tr>
            <td><code>type</code></td>
            <td><code>'text' | 'email' | 'password' | 'search'</code></td>
            <td><code>'text'</code></td>
            <td>Tipo nativo de input.</td>
          </tr>
          <tr>
            <td><code>name</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Nombre del campo de formulario. También se usa para derivar el id cuando no se proporciona.</td>
          </tr>
          <tr>
            <td><code>id</code></td>
            <td><code>string</code></td>
            <td><code>input-&#123;name&#125;</code></td>
            <td>id explícito del elemento input.</td>
          </tr>
          <tr>
            <td><code>required</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Marca el campo como obligatorio.</td>
          </tr>
          <tr>
            <td><code>error</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Mensaje de error que se muestra debajo del campo en color danger.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

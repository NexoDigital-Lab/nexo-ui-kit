---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import SearchBar from '../../components/SearchBar.astro';

const snippet = `<SearchBar />

<SearchBar placeholder="Search components..." name="component" />`;
---

<BaseLayout title="SearchBar — Nexo UI Kit" description="Uso y propiedades del componente SearchBar de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="SearchBar"
    subtitle="Formulario de búsqueda horizontal que compone Input y Button con un icono de lupa inicial."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Ejemplo</h2>
    <div class="docs-example">
      <SearchBar />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Placeholder y name personalizados</h2>
    <div class="docs-example">
      <SearchBar placeholder="Buscar componentes..." name="component" />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>placeholder</code></td>
            <td><code>string</code></td>
            <td><code>'Buscar...'</code></td>
            <td>Texto de placeholder dentro del campo de búsqueda.</td>
          </tr>
          <tr>
            <td><code>name</code></td>
            <td><code>string</code></td>
            <td><code>'q'</code></td>
            <td>Nombre del parámetro de consulta que se envía con el formulario.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

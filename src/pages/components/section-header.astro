---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const snippet = `<SectionHeader
  badge="Components"
  title="Section Header"
  subtitle="Badge, title and subtitle for page sections."
/>

<SectionHeader
  badge="Centered"
  title="Centered title"
  subtitle="Aligned to the center for hero-style sections."
  centered
  gradientTitle
/>`;
---

<BaseLayout title="SectionHeader — Nexo UI Kit" description="Ejemplos de alineación y título en degradado del componente SectionHeader de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="SectionHeader"
    subtitle="Compone un badge opcional, un título display y un subtítulo para secciones de página."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Alineado a la izquierda</h2>
    <div class="docs-example docs-example-stack">
      <SectionHeader
        badge="Fundación"
        title="Título alineado a la izquierda"
        subtitle="Alineación predeterminada — el badge, el título y el subtítulo se alinean al borde izquierdo."
      />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Centrado con título en degradado</h2>
    <div class="docs-example docs-example-stack docs-example-center">
      <SectionHeader
        badge="Vitrina"
        title="Título en degradado centrado"
        subtitle="centered más gradientTitle para encabezados de sección estilo hero."
        centered
        gradientTitle
      />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Sin badge ni subtítulo</h2>
    <div class="docs-example docs-example-stack">
      <SectionHeader title="Solo título" />
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>badge</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Etiqueta tipo píldora pequeña renderizada sobre el título.</td>
          </tr>
          <tr>
            <td><code>title</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Título de sección renderizado como encabezado.</td>
          </tr>
          <tr>
            <td><code>subtitle</code></td>
            <td><code>string</code></td>
            <td>—</td>
            <td>Texto de apoyo opcional debajo del título.</td>
          </tr>
          <tr>
            <td><code>centered</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Centra el contenido del encabezado horizontalmente.</td>
          </tr>
          <tr>
            <td><code>gradientTitle</code></td>
            <td><code>boolean</code></td>
            <td><code>false</code></td>
            <td>Aplica el efecto de texto en degradado de marca al título.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Tabs from '../../components/Tabs.astro';

const overviewTabs = [
  { id: 'overview', label: 'Resumen' },
  { id: 'usage', label: 'Uso' },
  { id: 'api', label: 'API' },
];

const panelCopy = {
  overview: 'Resumen general de la funcionalidad, la audiencia y los resultados.',
  usage: 'Guía paso a paso con ejemplos y valores predeterminados recomendados.',
  api: 'Propiedades, eventos y detalles de integración de la interfaz pública.',
};

const snippet = `<Tabs
  tabs={[
    { id: 'overview', label: 'Overview' },
    { id: 'usage', label: 'Usage' },
    { id: 'api', label: 'API' },
  ]}
  active="usage"
>
  <p slot="overview">Overview panel content.</p>
  <p slot="usage">Usage panel content.</p>
  <p slot="api">API panel content.</p>
</Tabs>`;
---

<BaseLayout title="Tabs — Nexo UI Kit" description="Estados de selección y cambio de panel en el cliente del componente Tabs de Nexo UI Kit.">
  <SectionHeader
    badge="Componentes"
    title="Tabs"
    subtitle="Lista de pestañas interactiva con subrayado en degradado para la pestaña activa y cambio de panel en el cliente."
  />

  <section class="docs-section">
    <h2 class="docs-h2">Activo: resumen</h2>
    <div class="docs-example docs-example-stack">
      <Tabs tabs={overviewTabs} active="overview">
        <p slot="overview">{panelCopy.overview}</p>
        <p slot="usage">{panelCopy.usage}</p>
        <p slot="api">{panelCopy.api}</p>
      </Tabs>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Activo: uso</h2>
    <div class="docs-example docs-example-stack">
      <Tabs tabs={overviewTabs} active="usage">
        <p slot="overview">{panelCopy.overview}</p>
        <p slot="usage">{panelCopy.usage}</p>
        <p slot="api">{panelCopy.api}</p>
      </Tabs>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Activo: api</h2>
    <div class="docs-example docs-example-stack">
      <Tabs tabs={overviewTabs} active="api">
        <p slot="overview">{panelCopy.overview}</p>
        <p slot="usage">{panelCopy.usage}</p>
        <p slot="api">{panelCopy.api}</p>
      </Tabs>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Selecciona la primera pestaña por defecto</h2>
    <div class="docs-example docs-example-stack">
      <Tabs tabs={overviewTabs}>
        <p slot="overview">Sin una prop <code class="docs-inline-code">active</code>, se selecciona la primera pestaña.</p>
        <p slot="usage">{panelCopy.usage}</p>
        <p slot="api">{panelCopy.api}</p>
      </Tabs>
    </div>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Uso</h2>
    <pre class="docs-code"><code>{snippet}</code></pre>
  </section>

  <section class="docs-section">
    <h2 class="docs-h2">Props</h2>
    <div class="docs-table-wrap">
      <table class="docs-table">
        <thead>
          <tr>
            <th>Prop</th>
            <th>Tipo</th>
            <th>Predeterminado</th>
            <th>Descripción</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>tabs</code></td>
            <td><code>&#123; id: string; label: string &#125;[]</code></td>
            <td>—</td>
            <td>Lista ordenada de botones de pestaña renderizados en el tablist.</td>
          </tr>
          <tr>
            <td><code>active</code></td>
            <td><code>string</code></td>
            <td><code>id</code> de la primera pestaña</td>
            <td>id de la pestaña seleccionada inicialmente.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="docs-note">
      Haz clic en una pestaña o usa las teclas de flecha para cambiar de panel. Pasa slots con nombre por cada id de pestaña para que todos los paneles tengan contenido.
    </p>
  </section>
</BaseLayout>

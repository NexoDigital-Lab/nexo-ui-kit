---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';

const components = [
  {
    href: '/components/button',
    name: 'Button',
    description: 'Acciones con variantes gradiente, outline, ghost y danger en tres tamaños.',
    badge: 'Acciones',
  },
  {
    href: '/components/badge',
    name: 'Badge',
    description: 'Etiquetas tipo píldora suaves para estado, categorías y metadatos.',
    badge: 'Visualización',
  },
  {
    href: '/components/card',
    name: 'Card',
    description: 'Contenedor de superficie elevada con resplandor hover opcional.',
    badge: 'Maquetación',
  },
  {
    href: '/components/input',
    name: 'Input',
    description: 'Campos de formulario oscuros con etiquetas, anillo de foco y estado de error.',
    badge: 'Formularios',
  },
  {
    href: '/components/search-bar',
    name: 'SearchBar',
    description: 'Campo de búsqueda con icono y botón de envío, listo para componer.',
    badge: 'Formularios',
  },
  {
    href: '/components/section-header',
    name: 'SectionHeader',
    description: 'Encabezado con badge, título y subtítulo para secciones de página.',
    badge: 'Maquetación',
  },
  {
    href: '/components/modal',
    name: 'Modal',
    description: 'Diálogo overlay con fondo oscurecido, tamaños y control de cierre.',
    badge: 'Superposición',
  },
  {
    href: '/components/toast',
    name: 'Toast',
    description: 'Notificaciones fijas con variantes de acento y control de descarte.',
    badge: 'Retroalimentación',
  },
  {
    href: '/components/tabs',
    name: 'Tabs',
    description: 'Lista de pestañas renderizada en servidor con subrayado activo en degradado.',
    badge: 'Navegación',
  },
  {
    href: '/components/avatar',
    name: 'Avatar',
    description: 'Imagen circular o iniciales en degradado con anillo neón.',
    badge: 'Visualización',
  },
  {
    href: '/components/empty-state',
    name: 'EmptyState',
    description: 'Marcador de vista vacía centrado con icono y slot de acción.',
    badge: 'Retroalimentación',
  },
  {
    href: '/components/background',
    name: 'GlowOrb',
    description: 'Orbes de resplandor radial decorativos en cyan, purple, magenta o brand.',
    badge: 'Decoración',
  },
  {
    href: '/components/background',
    name: 'ParticleField',
    description: 'Campo de partículas animado en canvas para fondos hero, con soporte de prefers-reduced-motion.',
    badge: 'Fondos',
  },
];
---

<BaseLayout title="Nexo UI Kit — Sistema de diseño" description="Nexo UI Kit es el sistema de diseño compartido y la biblioteca de componentes Astro de Nexo Digital Lab.">
  <section class="landing-hero">
    <Badge variant="cyan" dot>Sistema de diseño</Badge>
    <h1 class="landing-title nx-gradient-text">Nexo UI Kit</h1>
    <p class="landing-subtitle">
      El sistema de diseño compartido y la biblioteca de componentes Astro del
      ecosistema Nexo Digital — tokens, primitivas y documentación en un solo lugar.
    </p>
    <div class="landing-actions">
      <Button href="/components/button" variant="primary" size="lg">Ver componentes</Button>
      <Button href="/tokens" variant="secondary" size="lg">Ver tokens</Button>
    </div>
  </section>

  <section class="landing-components">
    <h2 class="landing-section-title">Componentes</h2>
    <div class="landing-grid">
      {
        components.map((item) => (
          <a href={item.href} class="landing-card-link">
            <Card>
              <Badge variant="purple" size="sm">{item.badge}</Badge>
              <h3 class="landing-card-name">{item.name}</h3>
              <p class="landing-card-desc">{item.description}</p>
            </Card>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--nx-space-5);
    padding: var(--nx-space-16) var(--nx-space-4) var(--nx-space-12);
  }

  .landing-title {
    font-family: var(--nx-font-display);
    font-size: clamp(2.8rem, 8vw, 5rem);
    font-weight: var(--nx-weight-extrabold);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .landing-subtitle {
    max-width: 600px;
    font-size: var(--nx-text-md);
    color: var(--nx-text-secondary);
    line-height: var(--nx-leading-relaxed);
  }

  .landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nx-space-4);
    justify-content: center;
    margin-top: var(--nx-space-2);
  }

  .landing-components {
    padding: 0 var(--nx-space-4) var(--nx-space-16);
    max-width: var(--nx-container-max);
    margin: 0 auto;
  }

  .landing-section-title {
    font-family: var(--nx-font-display);
    font-size: var(--nx-text-xl);
    font-weight: var(--nx-weight-bold);
    margin-bottom: var(--nx-space-6);
    text-align: center;
  }

  .landing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--nx-space-5);
  }

  .landing-card-link {
    display: block;
    height: 100%;
  }

  .landing-card-link :global(.nx-card) {
    height: 100%;
  }

  .landing-card-name {
    font-family: var(--nx-font-display);
    font-size: var(--nx-text-lg);
    font-weight: var(--nx-weight-bold);
    margin: var(--nx-space-3) 0 var(--nx-space-2);
    color: var(--nx-text-primary);
  }

  .landing-card-desc {
    font-size: var(--nx-text-sm);
    color: var(--nx-text-secondary);
    line-height: var(--nx-leading-normal);
  }
</style>
